# ---------------------------------------------------------------------------
# Supabase — the only backend this app uses
# ---------------------------------------------------------------------------
# Project settings -> API
#
# The anon key is designed to be public: every read/write in this app is
# constrained by Postgres row level security. Never put the service_role key
# in here — anything in a VITE_* variable is inlined into the public bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-API-KEY

# ---------------------------------------------------------------------------
# Store contact email (optional)
# ---------------------------------------------------------------------------
# Shown in the footer. The real order notification address is set in
# Admin -> Settings -> Contact email, which is what the order-notification
# Edge Function reads.
